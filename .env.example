# Paperclip tutor configuration (server-side only — never commit real keys).
# Copy to .env (or export these variables) before starting the server:
#   node server/server.js
#
# The browser never sees these values. The Paperclip API is the only place
# credentials are read.

# --- Server ---
HOST=127.0.0.1
PORT=8787

# --- Paperclip provider ---
# Built-in providers: opencode (OpenCode Zen), groq, mock (dev/testing).
PAPERCLIP_PROVIDER=opencode

# Primary model. Free OpenCode Zen options include:
#   deepseek-v4-flash-free   (default, free)
#   big-pickle               (free)
# Paid options, e.g. deepseek-v4-pro, are also accepted.
PAPERCLIP_MODEL=deepseek-v4-flash-free

# API key for the primary provider. Obtained at https://opencode.ai/auth
# OPENCODE_API_KEY is accepted as an alias.
PAPERCLIP_API_KEY=

# OpenCode Zen is OpenAI-compatible at https://opencode.ai/zen/v1
# PAPERCLIP_OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Optional fallback provider ---
# Tried only if the primary fails. Example: Groq free tier.
PAPERCLIP_FALLBACK_PROVIDER=
PAPERCLIP_FALLBACK_MODEL=
# PAPERCLIP_FALLBACK_PROVIDER=groq
# PAPERCLIP_FALLBACK_MODEL=llama-3.3-70b-versatile
PAPERCLIP_GROQ_API_KEY=

# --- Limits ---
PAPERCLIP_TIMEOUT_MS=30000
PAPERCLIP_MAX_OUTPUT_TOKENS=600
PAPERCLIP_MAX_MESSAGE_LENGTH=2000
PAPERCLIP_MAX_CONTEXT_BYTES=60000
PAPERCLIP_MAX_HISTORY_MESSAGES=8
PAPERCLIP_RATE_LIMIT_WINDOW_MS=60000
PAPERCLIP_RATE_LIMIT_MAX=12

# --- Mock provider (development) ---
# PAPERCLIP_PROVIDER=mock returns deterministic canned responses with no
# network or key, so the whole flow can be tested offline.
# PAPERCLIP_MOCK_FAILURE=1 makes the mock fail like an unavailable provider
# so error handling can be exercised.
PAPERCLIP_MOCK_FAILURE=0